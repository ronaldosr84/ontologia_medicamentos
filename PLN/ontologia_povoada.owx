<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/ronaldo/ontologies/2026/3/ontologia_medicamentos.owl"
         xmlns="http://www.semanticweb.org/ronaldo/ontologies/2026/3/ontologia_medicamentos.owl#">

<owl:Ontology rdf:about="http://www.semanticweb.org/ronaldo/ontologies/2026/3/ontologia_medicamentos.owl">
  <owl:versionIRI rdf:resource="http://www.semanticweb.org/ronaldo/ontologies/2026/3/ontologia_medicamentos.owl/1.0.0"/>
  <rdfs:comment xml:lang="pt-br">Ontologia de Medicamentos criada baseada na Ontologia Brasileira de Medicamentos</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#interageCom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Principio_Ativo"/>
  <rdfs:range rdf:resource="#Principio_Ativo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temAlergiaA">
  <rdfs:domain rdf:resource="#Paciente"/>
  <rdfs:range rdf:resource="#Principio_Ativo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temPrincipioAtivo">
  <rdfs:domain rdf:resource="#Medicamento"/>
  <rdfs:range rdf:resource="#Principio_Ativo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usaMedicamento">
  <rdfs:domain rdf:resource="#Paciente"/>
  <rdfs:range rdf:resource="#Medicamento"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Apresentacao"/>

<owl:Class rdf:about="#Contraindicacao"/>

<owl:Class rdf:about="#InteracaoMedicamento"/>

<owl:Class rdf:about="#Medicamento"/>

<owl:Class rdf:about="#MedicamentoContraindicadoPorAlergia">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Medicamento"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temPrincipioAtivo"/>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty>
                <rdf:Description>
                  <owl:inverseOf rdf:resource="#temAlergiaA"/>
                </rdf:Description>
              </owl:onProperty>
              <owl:someValuesFrom rdf:resource="#Paciente"/>
            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#MedicamentosComRiscoDeInteracao">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Medicamento"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temPrincipioAtivo"/>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#interageCom"/>
              <owl:someValuesFrom rdf:resource="#Principio_Ativo"/>
            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Paciente"/>

<owl:Class rdf:about="#Principio_Ativo"/>

<owl:Class rdf:about="#Produto_Medicinal_Comercial_(AMP)">
  <rdfs:subClassOf rdf:resource="#Medicamento"/>
</owl:Class>

<owl:Class rdf:about="#Produto_Medicinal_Comercial_com_Apresentacao_(AMPP)">
  <rdfs:subClassOf rdf:resource="#Apresentacao"/>
</owl:Class>

<owl:Class rdf:about="#Produto_Medicinal_Virtual_(VMP)">
  <rdfs:subClassOf rdf:resource="#Medicamento"/>
</owl:Class>

<owl:Class rdf:about="#Produto_Medicinal_Virtual_com_Apresentacao_(VMPP)">
  <rdfs:subClassOf rdf:resource="#Apresentacao"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#alivium">
